ANTHROPIC_API_KEY="sk-ant-..."

# === Sender (Resend OR SMTP) ===
# If RESEND_API_KEY is set, the script sends via Resend (resend.com) and ignores
# the SMTP_* vars. Otherwise it falls back to SMTP.
#
# Resend setup:
#   1. Sign up at resend.com (free 3000 emails/month).
#   2. Add lightriderinc.com under Domains; copy the DNS records (SPF/DKIM/DMARC)
#      and have IT add them to the lightriderinc.com zone.
#   3. Wait for verification (usually <1h).
#   4. Generate an API key in Resend dashboard → API Keys.
# RESEND_API_KEY="re_..."
# SENDER_EMAIL="noreply@lightriderinc.com"  # must be on a verified Resend domain

# === SMTP fallback ===
# Gmail example (defaults):
#   SENDER_EMAIL="youraddress@gmail.com"
#   SENDER_APP_PASSWORD="abcdefghijklmnop"   # 16-char Gmail App Password
#   SMTP_HOST="smtp.gmail.com"  (default)
#   SMTP_PORT="587"             (default)
#   SMTP_USE_SSL="false"        (default, uses STARTTLS)
#
# noreply@lightriderinc.com via Microsoft 365:
SENDER_EMAIL="noreply@lightriderinc.com"
SENDER_APP_PASSWORD="<smtp-password-or-app-password>"
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USE_SSL="false"
# SMTP_USERNAME defaults to SENDER_EMAIL. Override only if the SMTP login is
# a different identity than the From: address.

RECEIVER_EMAIL="zguo@lightriderinc.com"

# Optional:
# STATE_FILE=state.json
# CLAUDE_MODEL=claude-sonnet-4-6
